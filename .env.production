# Noah Platform - Production Environment Variables
# Copy this file to .env.production.local and update with your values

# ============================================
# DEPLOYMENT TYPE
# ============================================
DEPLOYMENT_TYPE=aws # Options: aws, vercel, vps, docker

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
APP_NAME=Noah Media Platform
APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com
PORT=4000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# AWS RDS Example:
DATABASE_URL=postgresql://noah_admin:your-secure-password@your-rds-endpoint.amazonaws.com:5432/noah_production

# Supabase Example:
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Local/VPS Example:
# DATABASE_URL=postgresql://noah:password@localhost:5432/noah_production

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=10000

# ============================================
# REDIS CACHE
# ============================================
# AWS ElastiCache Example:
REDIS_URL=redis://default:password@your-redis-cluster.cache.amazonaws.com:6379

# Upstash Example:
# REDIS_URL=redis://default:password@your-endpoint.upstash.io:6379

# Local/VPS Example:
# REDIS_URL=redis://:password@localhost:6379

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate secure secrets (minimum 32 characters):
# openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-minimum-32-characters
SESSION_SECRET=your-super-secure-session-secret-minimum-32-characters

# Token Expiry
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_EXPIRY=24h

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# ============================================
# STORAGE (S3/MinIO/B2)
# ============================================
# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=noah-media-production
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# OR MinIO (S3-compatible)
MINIO_ENDPOINT=minio.your-domain.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=noah-media

# OR Backblaze B2
B2_KEY_ID=001cb7600b546c10000000005
B2_APPLICATION_KEY=K001boaD/JlGocs7ZH/Ceh4RbtlnGlw
B2_BUCKET_NAME=FullViewNoah
B2_ENDPOINT=https://s3.us-west-001.backblazeb2.com  # Optional, change based on your region
B2_REGION=us-west-001  # Optional, change based on your bucket location

# ============================================
# CDN & MEDIA DELIVERY
# ============================================
CDN_URL=https://cdn.your-domain.com
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
CLOUDFRONT_KEY_PAIR_ID=APKA1234567890ABC
MEDIA_UPLOAD_MAX_SIZE=500000000 # 500MB in bytes

# ============================================
# EMAIL SERVICE
# ============================================
# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=Noah Platform

# OR AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_FROM_EMAIL=noreply@your-domain.com

# OR SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry Error Tracking
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# DataDog APM
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
MIXPANEL_TOKEN=your-mixpanel-token

# ============================================
# AI & PROCESSING SERVICES
# ============================================
# OpenAI (for metadata extraction)
OPENAI_API_KEY=sk-your-openai-api-key

# Replicate (for video processing)
REPLICATE_API_TOKEN=r8_your_replicate_token

# Assembly AI (for transcription)
ASSEMBLY_API_KEY=your-assembly-ai-key

# ============================================
# PAYMENT & BILLING (Stripe)
# ============================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_BASIC=price_basic_monthly
STRIPE_PRICE_ID_PRO=price_pro_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_UPLOAD_MAX=10 # Max uploads per minute

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
CORS_CREDENTIALS=true
HELMET_CSP_DIRECTIVES={"defaultSrc":["'self'"],"scriptSrc":["'self'","'unsafe-inline'"]}

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SIGNUP=true
ENABLE_MFA=true
ENABLE_SOCIAL_AUTH=false
ENABLE_AI_TAGGING=false
ENABLE_VIDEO_COMPRESSION=true
ENABLE_WATERMARK=false
ENABLE_ANALYTICS=true
MAINTENANCE_MODE=false

# ============================================
# PERFORMANCE
# ============================================
ENABLE_CACHE=true
CACHE_TTL=3600 # 1 hour in seconds
ENABLE_COMPRESSION=true
CLUSTER_WORKERS=auto # auto or number

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info # debug, info, warn, error
LOG_FORMAT=json # json or pretty
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/noah/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30

# ============================================
# BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=noah-backups
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#noah-notifications

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Zapier
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR/WEBHOOK

# ============================================
# DEVELOPMENT & DEBUG (Set to false in production)
# ============================================
DEBUG=false
VERBOSE_ERRORS=false
SHOW_STACK_TRACES=false
ENABLE_SWAGGER=false
ENABLE_GRAPHQL_PLAYGROUND=false