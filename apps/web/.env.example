# Environment variables for Noah Web Frontend
# Copy this to .env for local development

# For local development with proxy (recommended)
# Leave empty to use Vite proxy to localhost:3000
VITE_API_URL=

# For production or direct API access
# VITE_API_URL=https://noah-production-e15c.up.railway.app/api

# App Configuration
VITE_APP_NAME=Noah Media Platform
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false

# Asset URLs (optional)
VITE_ASSET_URL=
