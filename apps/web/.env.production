# Production environment variables for Noah Web Frontend

# Backend API URL - Point to your Railway backend
VITE_API_URL=https://noah-production-e15c.up.railway.app/api

# App Information
VITE_APP_NAME=Noah Media Platform
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true