# API Server Environment Variables
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://noah_user:noah_dev_password@pgbouncer:5432/noah_dev

# Redis Connection
REDIS_URL=redis://:noah_redis_password@redis-master:6379

# JWT Authentication
JWT_SECRET=development_jwt_secret_key_replace_in_production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
COOKIE_SECRET=development_cookie_secret_key_replace_in_production

# MFA Configuration
MFA_ISSUER=Noah Media Platform (Dev)

# Cross-Origin Resource Sharing
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=noah-api
KAFKA_GROUP_ID=noah-api-group

# S3 Storage Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=noah_minio_user
S3_SECRET_KEY=noah_minio_password
S3_BUCKET=noah-assets
S3_REGION=us-east-1

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email Service - Configure for actual email sending in production
EMAIL_FROM=no-reply@noah-platform.com
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_SECURE=false

# Server Configuration
PORT=4000
HOST=0.0.0.0
