// packages/@noah/db/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"] // For potential future use with pg_trgm
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  planType         String    @db.VarChar(50)
  storageQuotaBytes BigInt   @default(1099511627776) // 1TB default
  storageUsedBytes BigInt   @default(0)
  maxUsers         Int      @default(10)
  features         Json     @default("{}") @db.JsonB
  metadata         Json     @default("{}") @db.JsonB
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  
  users        User[]
  assets       Asset[]
  collections  Collection[]
  tags         Tag[]
  shareLinks   ShareLink[]
  annotations  Annotation[]
  auditLogs    AuditLog[]
  notifications Notification[]

  @@map("organizations")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String    @unique @db.VarChar(255)
  emailVerified Boolean @default(false) // Email verification status
  name        String?   @db.VarChar(255)
  passwordHash String?  @db.VarChar(255) // Added for direct password auth
  phone       String?   @db.VarChar(50) // Store User Phone Number
  hubspotUtk  String?   @db.VarChar(255) // Store Hubspot Cookie
  roleId      String?   @db.Uuid
  roleRelation Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  preferences Json     @default("{}") @db.JsonB
  mfaSecret   String?   @db.VarChar(255) // Secret key for TOTP MFA
  mfaEnabled  Boolean   @default(false)  // Whether MFA is enabled
  emailOTP    String?   @db.VarChar(10)  // Store Email OTP code
  emailOtpExpiresAt     DateTime? @db.Timestamptz(6) // OTP expiration time    
  status      String    @default("active") @db.VarChar(50) // active, inactive, suspended
  failedLoginAttempts Int @default(0)     // Track failed login attempts
  lockoutUntil DateTime? @db.Timestamptz(6) // Account lockout timestamp
  lastLoginAt DateTime? @db.Timestamptz(6)
  lastActiveAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  jobTitle    String?   @db.VarChar(255)
  annotations  Annotation[]
  uploadedAssets Asset[] @relation("UploadedBy")
  deletedAssets  Asset[] @relation("AssetDeletedBy")
  createdCollections  Collection[] @relation("CreatedBy")
  addedToCollections  CollectionAsset[]
  addedAssetTags      AssetTag[]
  createdShareLinks   ShareLink[]
  auditLogs           AuditLog[]
  analyticsEvents     AnalyticsEvent[]
  createdAssetVersions AssetVersion[]
  notifications       Notification[]

  @@unique([orgId, email], name: "unique_email_per_org")
  // Sessions related to this user
  sessions UserSession[]

  // Password reset tokens
  passwordResetTokens PasswordResetToken[]

  // Email verification tokens
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  
  @@index([token])
  @@map("password_reset_tokens")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  
  @@index([token])
  @@map("email_verification_tokens")
}

// User sessions for authentication
model UserSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String   @unique @db.Text
  refreshToken    String?  @db.Text
  ipAddress       String?  @db.VarChar(50)
  userAgent       String?  @db.Text
  expiresAt       DateTime @db.Timestamptz(6)
  lastActiveAt    DateTime @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  
  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}


model Collection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentId        String?   @db.Uuid
  parentCollection Collection? @relation("CollectionHierarchy", fields: [parentId], references: [id])
  childCollections Collection[] @relation("CollectionHierarchy")
  name            String    @db.VarChar(255)
  description     String?
  type            String    @default("manual") @db.VarChar(50) // e.g., manual, smart
  rules           Json?    @db.JsonB // For smart collections
  thumbnailAssetId String?  @db.Uuid
  thumbnailAsset  Asset? @relation("ThumbnailAsset", fields: [thumbnailAssetId], references: [id])
  metadata        Json     @default("{}") @db.JsonB
  createdById     String?   @db.Uuid
  createdBy       User?     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  collectionAssets CollectionAsset[]
  shareLinks       ShareLink[]

  @@index([orgId])
  @@map("collections")
}

model CollectionAsset {
  collectionId String @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetId      String @db.Uuid
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position     Int    @default(0)
  addedById    String? @db.Uuid
  addedBy      User?  @relation(fields: [addedById], references: [id])
  addedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([collectionId, assetId])
  @@index([assetId])
  @@map("collection_assets")
}

model AssetVersion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId         String    @db.Uuid
  asset           Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  versionNumber   Int
  changeDescription String?
  createdById     String?   @db.Uuid
  createdBy       User?     @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([assetId, versionNumber])
  @@map("asset_versions")
}

model Tag {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(100)
  color       String?   @db.VarChar(7) // Hex color
  category    String?   @db.VarChar(50)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  assetTags   AssetTag[]

  @@unique([orgId, name], name: "unique_tag_per_org")
  @@map("tags")
}

model AssetTag {
  assetId    String    @db.Uuid
  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId      String    @db.Uuid
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedById  String?   @db.Uuid
  addedBy    User?     @relation(fields: [addedById], references: [id])
  addedAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@id([assetId, tagId])
  @@map("asset_tags")
}

model ShareLink {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId         String?   @db.Uuid
  asset           Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  collectionId    String?   @db.Uuid
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  token           String    @unique @db.VarChar(255)
  passwordHash    String?   @db.VarChar(255)
  expiresAt       DateTime? @db.Timestamptz(6)
  maxDownloads    Int?
  downloadCount   Int       @default(0)
  permissions     Json     @default("{\"view\": true, \"download\": false}") @db.JsonB
  createdById     String?   @db.Uuid
  createdBy       User?     @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  lastAccessedAt  DateTime? @db.Timestamptz(6)

  @@index([orgId])
  @@map("share_links")
}

// Analytics events hypertable
// Note: create_hypertable is done via raw SQL migration script
model AnalyticsEvent {
  id           String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @db.Uuid
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id])
  eventType    String    @db.VarChar(100)
  assetId      String?   @db.Uuid
  asset        Asset? @relation(fields: [assetId], references: [id])
  properties   Json     @default("{}") @db.JsonB
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@id([id, createdAt]) // TimescaleDB requires composite primary key on time column
  @@index([orgId, createdAt(sort: Desc)])
  @@map("analytics_events")
}

// Annotation model
model Annotation {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String       @db.Uuid
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId         String       @db.Uuid
  mediaAsset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The type of annotation: e.g., 'comment', 'drawing', 'shape', 'stamp', 'group'
  type            String       @db.VarChar(50)

  // JSON payload containing tool-specific data (e.g. coordinates, strokes, text, color, replies)
  data            Json         @default("{}") @db.JsonB

  // Helper columns for fast querying and indexing
  videoTimestamp  Decimal?     @db.Decimal(10, 3)
  resolved        Boolean      @default(false)

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([orgId])
  @@index([assetId])
  @@index([userId])
  @@index([type])
  @@map("annotations")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  show        Int?
  users       User[]
  permissions RolePermission[]
  @@map("roles")
}

// Note: create_hypertable is done via raw SQL migration script
model AuditLog {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityName  String        @db.VarChar(255)
  description   String?       @db.Text
  activityType  String?       @db.VarChar(100)

  actorType     String        @default("user") @db.VarChar(20) // 'user' | 'system' | 'cron'
  userName      String?       @db.VarChar(255)
  userEmail     String?       @db.VarChar(255)
  userRole      String?       @db.VarChar(50)

  error         String?       @db.Text

  userId        String?       @db.Uuid
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  orgId         String?       @db.Uuid
  organization  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  deletedAt     DateTime?     @db.Timestamptz(6)

  @@index([orgId])
  @@index([userId])
  @@index([actorType])
  @@map("audit_logs")
}


model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(255)
  name        String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}
// --- NEW ENTERPRISE ASSET ARCHITECTURE ---

model Asset {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String       @db.Uuid
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title             String       @db.VarChar(500)
  type              String       @db.VarChar(50) // 'video', 'audio', 'image', 'document'
  status            String       @default("active") @db.VarChar(50) // 'active', 'archived', 'trash', 'pending_admin_review', 'pending_super_admin'
  compressedKey     String?      @db.VarChar(1000) // Deterministic key for the compressed proxy file
  aiTags            Json         @default("[]") @db.JsonB
  
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?    @db.Timestamptz(6)
  deletedByUserId   String?      @db.Uuid
  deletedBy         User?        @relation("AssetDeletedBy", fields: [deletedByUserId], references: [id])
  
  files             AssetFile[]
  metadata          AssetMetadata?
  transcodeJobs     TranscodeJob[]

  uploadedByUserId  String?      @db.Uuid
  uploadedBy        User?        @relation("UploadedBy", fields: [uploadedByUserId], references: [id])

  annotations  Annotation[]
  collectionAssets CollectionAsset[]
  assetVersions    AssetVersion[]
  assetTags        AssetTag[]
  shareLinks       ShareLink[]
  analyticsEvents  AnalyticsEvent[]
  thumbnailForCollections Collection[] @relation("ThumbnailAsset")
  videoFrameHashes VideoFrameHash[]


  @@index([orgId])
  @@index([status])
  @@index([type])
  @@index([compressedKey])
  @@map("assets")
}

model AssetFile {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId           String     @db.Uuid
  asset             Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileClass         String     @db.VarChar(50) // 'original', 'proxy', 'thumbnail', 'hls_playlist'
  fileName          String     @db.VarChar(500)
  filePath          String     @db.VarChar(1000) // B2 Key
  sizeBytes         BigInt
  mimeType          String     @db.VarChar(100)
  cdnUrl            String?    @db.VarChar(500)
  
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  
  @@index([assetId])
  @@index([fileClass])
  @@map("asset_files")
}

model AssetMetadata {
  assetId           String     @id @db.Uuid
  asset             Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technicalSpecs    Json       @default("{}") @db.JsonB // width, height, fps, bitrate, codec, duration
  customProperties  Json       @default("{}") @db.JsonB // user-defined metadata
  checksum          String?    @db.VarChar(64)
  
  @@map("asset_metadata")
}

model TranscodeJob {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId           String     @db.Uuid
  asset             Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider          String     @db.VarChar(50) // 'coconut', 'aws_mediaconvert'
  jobId             String?    @unique @db.VarChar(255)
  status            String     @default("queued") @db.VarChar(50) // 'queued', 'processing', 'completed', 'failed'
  providerMetadata  Json       @default("{}") @db.JsonB // API responses, errors
  
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  
  @@index([assetId])
  @@index([status])
  @@map("transcode_jobs")
}

model VideoFrameHash {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId    String   @db.Uuid
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  frameIndex Int
  hashValue  String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([assetId])
  @@map("video_frame_hashes")
}

model Notification {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId           String   @db.Uuid
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title           String   @db.VarChar(255)
  message         String   @db.Text
  type            String   @db.VarChar(50) // e.g., 'approval_request', 'deletion_approved', 'deletion_rejected'
  isRead          Boolean  @default(false)
  relatedEntityId String?  @db.Uuid // Optional link to an Asset
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([orgId])
  @@map("notifications")
}
