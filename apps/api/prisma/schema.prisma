// packages/@noah/db/prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"] // For potential future use with pg_trgm
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @db.VarChar(100)
  slug              String   @unique @db.VarChar(255)
  storageUsedBytes BigInt   @default(0)
  metadata         Json     @default("{}") @db.JsonB
  status           String   @default("active") @db.VarChar(50) // active | suspended
  currentPlanId    String?  @db.VarChar(255)
  currentPlan      Plan?    @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)
  stripeCustomerId String?  @db.VarChar(255)
  subscriptionStatus String? @db.VarChar(50)
  planExpiresAt    DateTime? @map("plan_expires_at") @db.Timestamptz(6)
  isFreeTrialUsed  Boolean   @default(false) @map("is_free_trial_used")
  usageWarningPercent Int    @default(80)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users        User[]
  assets       Asset[]
  collections  Collection[]
  tags         Tag[]
  shareLinks   ShareLink[]
  annotations  Annotation[]
  auditLogs    AuditLog[]
  paymentLogs  PaymentLog[]
  notifications Notification[]
  annotationGroups AnnotationGroup[]
  userGroups       UserGroup[]
  moderationFlags  PlatformModerationFlag[]
  storageSystems   StorageSystem[]
  usageEvents      UsageEvent[]
  usageDailyRollups UsageDailyRollup[]

  workspaces Workspace[]
  settings   OrganizationSettings?

  @@map("organizations")
}

model OrganizationSettings {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @unique @db.Uuid
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  // Share Settings
  requirePasswordDefault Boolean @default(false) @map("require_password_default")
  allowCommentsDefault   Boolean @default(false) @map("allow_comments_default")
  allowDownloadOriginalDefault Boolean @default(true) @map("allow_download_original_default")
  allowDownloadProxyDefault    Boolean @default(true) @map("allow_download_proxy_default")
  showCompanyWatermarkDefault  Boolean @default(true) @map("show_company_watermark_default")
  defaultExpiryDays      Int     @default(30) @map("default_expiry_days")

  createdAt         DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@map("organization_settings")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String    @unique @db.VarChar(255)
  emailVerified Boolean @default(false) // Email verification status
  name        String?   @db.VarChar(100)
  timezone    String?   @db.VarChar(100)
  avatarUrl   String?   @db.VarChar(1000)
  avatarKey   String?   @db.VarChar(1000)
  passwordHash String?  @db.VarChar(255) // Added for direct password auth
  phone       String?   @db.VarChar(50) // Store User Phone Number
  hubspotUtk  String?   @db.VarChar(255) // Store Hubspot Cookie
  roleId      String?   @db.Uuid
  roleRelation Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  preferences Json     @default("{}") @db.JsonB
  mfaSecret   String?   @db.VarChar(255) // Secret key for TOTP MFA
  mfaEnabled  Boolean   @default(false)  // Whether MFA is enabled
  emailOTP    String?   @db.VarChar(10)  // Store Email OTP code
  emailOtpExpiresAt     DateTime? @db.Timestamptz(6) // OTP expiration time    
  status      String    @default("active") @db.VarChar(50) // active, inactive, suspended
  failedLoginAttempts Int @default(0)     // Track failed login attempts
  lockoutUntil DateTime? @db.Timestamptz(6) // Account lockout timestamp
  lastLoginAt DateTime? @db.Timestamptz(6)
  lastActiveAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  jobTitle    String?   @db.VarChar(100)
  annotations  Annotation[]
  uploadedAssets Asset[] @relation("UploadedBy")
  deletedAssets  Asset[] @relation("AssetDeletedBy")
  createdCollections  Collection[] @relation("CreatedBy")
  addedToCollections  CollectionAsset[]
  addedAssetTags      AssetTag[]
  createdShareLinks   ShareLink[]
  auditLogs           AuditLog[]
  paymentLogs         PaymentLog[]
  analyticsEvents     AnalyticsEvent[]
  createdAssetVersions AssetVersion[]
  notifications       Notification[]
  annotationGroupMembers AnnotationGroupMember[]
  workspaceUsers     WorkspaceUser[]
  projectUsers       ProjectUser[]
  folderUsers        FolderUser[]
  assetUsers         AssetUser[]
  // Sessions related to this user
  sessions             UserSession[]

  favorites            Favorite[]
  createdTags          Tag[]      @relation("TagCreatedBy")
  addedProjectTags     ProjectTag[] @relation("ProjectTagAddedBy")
  userGroupMembers     UserGroupMember[]
  createdUserGroups    UserGroup[]  @relation("GroupCreatedBy")
  createdProjects      Project[]  @relation("ProjectCreatedBy")
  deletedProjects      Project[]  @relation("ProjectDeletedBy")

  // Password reset tokens
  passwordResetTokens PasswordResetToken[]

  // Email verification tokens
  emailVerificationTokens EmailVerificationToken[]

  @@unique([orgId, email], name: "unique_email_per_org")
  @@map("users")
}

// Password reset tokens
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique @db.VarChar(255)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([token])
  @@map("password_reset_tokens")
}

// Email verification tokens
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique @db.VarChar(255)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([token])
  @@map("email_verification_tokens")
}

// User sessions for authentication
model UserSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String    @unique @db.Text
  refreshToken String?   @db.Text
  ipAddress    String?   @db.VarChar(50)
  userAgent    String?   @db.Text
  expiresAt    DateTime  @db.Timestamptz(6)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}

//Adding workspaces schema here
model Workspace {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  color       String? @db.VarChar(50)
  visibility  String  @default("private") @db.VarChar(50)
  isDefault   Boolean @default(false) @map("is_default")

  orgId        String       @map("org_id") @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  folders  Folder[]
  projects Project[]
  assets   Asset[]
  users  WorkspaceUser[]
  groups WorkspaceGroup[]
  favorites Favorite[]
  annotationGroups AnnotationGroup[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orgId])
  @@map("workspaces")
}

model WorkspaceUser {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id")
  userId      String @map("user_id") @db.Uuid
  memberType  String @default("MEMBER") @map("member_type") @db.VarChar(50)
  accessLevelId String? @map("access_level_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLevelRef AccessLevel? @relation("WorkspaceUserAccess", fields: [accessLevelId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_users")
}

model WorkspaceGroup {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id")
  groupId     String    @map("group_id") @db.Uuid
  accessLevelId String? @map("access_level_id") @db.Uuid

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessLevelRef AccessLevel? @relation("WorkspaceGroupAccess", fields: [accessLevelId], references: [id])

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([workspaceId, groupId])
  @@index([workspaceId])
  @@index([groupId])
  @@map("workspace_groups")
}

model Folder {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  color       String?
  workspaceId String  @map("workspace_id")
  parentId    String? @map("parent_folder_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderToFolder")

  // Files/Projects owned directly by this folder (ownerType = "folder")
  projects Project[]

  sources ProjectSource[] @relation("FolderAsSource")
  users   FolderUser[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  favorites Favorite[]

  @@index([workspaceId])
  @@index([parentId])
  @@map("folders")
}
model FolderUser {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId String @map("folder_id")
  userId   String @map("user_id") @db.Uuid

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([folderId, userId])
  @@index([folderId])
  @@index([userId])
  @@map("folder_users")
}

// ownerType tells you which relation (workspaceId or folderId) is the active one.
enum MediaAssetOwnerType {
  WORKSPACE
  FOLDER
}

model Asset {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title        String       @db.VarChar(255)
  type         String       @db.VarChar(50) // 'video', 'audio', 'image', 'document'
  status       String       @default("active") @db.VarChar(50) // 'active', 'archived', 'trash'
  visibility   String       @default("public") @db.VarChar(50) // 'public', 'private'
  compressedKey     String?      @db.VarChar(1000) // Deterministic key for the compressed proxy file
  aiTags       Json         @default("[]") @db.JsonB

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  deletedByUserId   String?      @db.Uuid
  deletedBy         User?        @relation("AssetDeletedBy", fields: [deletedByUserId], references: [id])
  deletionReason    String?      @db.VarChar(500)

  files                   AssetFile[]
  metadata                AssetMetadata?
  transcodeJobs           TranscodeJob[]
  ownerType               MediaAssetOwnerType // WORKSPACE, FOLDER, or PROJECT
  ownerId                 String              @db.Uuid // points to Workspace.id, Folder.id, or Project.id depending on ownerType
  uploadedByUserId        String?             @db.Uuid
  uploadedBy              User?               @relation("UploadedBy", fields: [uploadedByUserId], references: [id])
  workspaceId             String?             @map("workspace_id")
  workspace               Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  annotations             Annotation[]
  collectionAssets        CollectionAsset[]
  assetVersions           AssetVersion[]
  assetTags               AssetTag[]
  shareLinks              ShareLink[]
  analyticsEvents         AnalyticsEvent[]
  thumbnailForCollections Collection[]        @relation("ThumbnailAsset")
  videoFrameHashes        VideoFrameHash[]

  sources ProjectSource[] @relation("AssetAsSource")
  users   AssetUser[]
  assetGroups AssetGroup[]

  favorites Favorite[]
  annotationGroups AnnotationGroup[]

  @@index([orgId])
  @@index([status])
  @@index([type])
  @@index([compressedKey])
  @@index([ownerType, ownerId])
  @@map("assets")
}


model AssetUser {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  accessLevel String @default("Full Access") @map("access_level") @db.VarChar(50)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([assetId, userId])
  @@index([assetId])
  @@index([userId])
  @@map("asset_users")
}

model AssetGroup {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid
  accessLevel String @default("Full Access") @map("access_level") @db.VarChar(50)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  group UserGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([assetId, groupId])
  @@index([assetId])
  @@index([groupId])
  @@map("asset_groups")
}

model Project {
  id        String              @id @default(uuid())
  name      String  @db.VarChar(100)
  ownerType MediaAssetOwnerType @map("owner_type")
  visibility String @default("public") @db.VarChar(20)
  status     String @default("active") @db.VarChar(50) // active, inactive

  workspaceId String? @map("workspace_id") // set when ownerType = WORKSPACE
  folderId    String? @map("folder_id") // set when ownerType = FOLDER

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)

  sources     ProjectSource[]
  users       ProjectUser[]
  groups      ProjectGroup[]
  defaultTags ProjectTag[]

  favorites Favorite[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy User? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId String? @map("deleted_by_user_id") @db.Uuid
  deletedBy User? @relation("ProjectDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletionReason String? @map("deletion_reason") @db.VarChar(500)

  @@index([workspaceId])
  @@index([folderId])
  @@index([createdById])
  @@map("projects")
}

model ProjectUser {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id")
  userId    String @map("user_id") @db.Uuid
  accessLevelId String? @map("access_level_id") @db.Uuid
  memberType  String @default("Member") @map("member_type") @db.VarChar(50)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLevelObj AccessLevel? @relation("ProjectUserAccess", fields: [accessLevelId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_users")
}

model ProjectGroup {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String @map("project_id")
  groupId     String @map("group_id") @db.Uuid
  accessLevelId String? @map("access_level_id") @db.Uuid

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessLevelObj AccessLevel? @relation("ProjectGroupAccess", fields: [accessLevelId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([projectId, groupId])
  @@index([projectId])
  @@index([groupId])
  @@map("project_groups")
}



// Reference table: which files/folders a Project pulls in as a source.
// Not related to ownership/placement above — purely "linked for AI reference".

enum SourceableType {
  ASSET
  FOLDER
}

model ProjectSource {
  id             String         @id @default(uuid())
  projectId      String         @map("project_id")
  sourceableType SourceableType @map("sourceable_type")

  assetId  String? @map("asset_id") @db.Uuid // set when sourceableType = ASSET
  folderId String? @map("folder_id") // set when sourceableType = FOLDER

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation("AssetAsSource", fields: [assetId], references: [id], onDelete: Cascade)
  folder  Folder? @relation("FolderAsSource", fields: [folderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, assetId])
  @@unique([projectId, folderId])
  @@index([projectId])
  @@map("project_sources")
}

model Collection {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String       @db.Uuid
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentId         String?      @db.Uuid
  parentCollection Collection?  @relation("CollectionHierarchy", fields: [parentId], references: [id])
  childCollections Collection[] @relation("CollectionHierarchy")
  name             String       @db.VarChar(255)
  description      String?
  type             String       @default("manual") @db.VarChar(50) // e.g., manual, smart
  rules            Json?        @db.JsonB // For smart collections
  thumbnailAssetId String?      @db.Uuid
  thumbnailAsset   Asset?       @relation("ThumbnailAsset", fields: [thumbnailAssetId], references: [id])
  metadata         Json         @default("{}") @db.JsonB
  createdById      String?      @db.Uuid
  createdBy        User?        @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  collectionAssets CollectionAsset[]
  shareLinks       ShareLink[]

  @@index([orgId])
  @@map("collections")
}

model CollectionAsset {
  collectionId String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetId      String     @db.Uuid
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  addedById    String?    @db.Uuid
  addedBy      User?      @relation(fields: [addedById], references: [id])
  addedAt      DateTime   @default(now()) @db.Timestamptz(6)

  @@id([collectionId, assetId])
  @@index([assetId])
  @@map("collection_assets")
}

model AssetVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId           String   @db.Uuid
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  versionNumber     Int
  changeDescription String?
  createdById       String?  @db.Uuid
  createdBy         User?    @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([assetId, versionNumber])
  @@map("asset_versions")
}

model Tag {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String       @db.VarChar(50)
  color        String?      @db.VarChar(7)  // Hex color
  category     String?      @db.VarChar(50)

  // --- Hierarchy ---
  // A tag can have an optional parent. Same name is allowed under different parents.
  parentId     String?      @db.Uuid @map("parent_id")
  parent       Tag?         @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Tag[]        @relation("TagHierarchy")

  // --- Scope ---
  // personal = only visible to createdBy user
  // company  = shared across the whole org
  // project  = scoped to a specific workspace
  scope        String       @default("company") @db.VarChar(20) // personal | company | project
  workspaceId  String?      @db.Uuid @map("workspace_id") // required when scope = project
  createdById  String?      @db.Uuid @map("created_by_id")  // required when scope = personal
  createdBy    User?        @relation("TagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  assetTags    AssetTag[]
  projectTags  ProjectTag[]

  // Name is unique within the same org + same parent (null parent = root level)
  @@unique([orgId, parentId, name], name: "unique_tag_name_per_parent")
  @@index([orgId])
  @@index([parentId])
  @@index([scope])
  @@index([workspaceId])
  @@map("tags")
}

// Stores which tags are the default for a project.
// When a file is uploaded/linked to a project, these tags (+ their ancestors) are auto-applied.
model ProjectTag {
  projectId String  @map("project_id")
  tagId     String  @db.Uuid @map("tag_id")
  addedById String? @db.Uuid @map("added_by_id")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy   User?    @relation("ProjectTagAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  addedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@id([projectId, tagId])
  @@index([projectId])
  @@index([tagId])
  @@map("project_tags")
}

model AssetTag {
  assetId   String   @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId     String   @db.Uuid
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedById String?  @db.Uuid
  addedBy   User?    @relation(fields: [addedById], references: [id])
  addedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@id([assetId, tagId])
  @@map("asset_tags")
}

model ShareLink {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String               @db.Uuid
  organization   Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId        String?              @db.Uuid
  asset          Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  collectionId   String?              @db.Uuid
  collection     Collection?          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name           String?              @db.VarChar(100)
  visibility     String               @default("public") @db.VarChar(50)
  token          String               @unique @db.VarChar(255)
  mode           String               @default("link") @db.VarChar(50)
  passwordHash   String?              @db.VarChar(255)
  expiresAt      DateTime?            @db.Timestamptz(6)
  revokedAt      DateTime?            @db.Timestamptz(6)
  maxDownloads   Int?
  downloadCount  Int                  @default(0)
  permissions    Json                 @default("{\"view\": true, \"comment\": false, \"download\": false, \"downloadProxy\": false}") @db.JsonB
  createdById    String?              @db.Uuid
  createdBy      User?                @relation(fields: [createdById], references: [id])
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  lastAccessedAt DateTime?            @db.Timestamptz(6)
  recipients     ShareLinkRecipient[]

  @@index([orgId])
  @@map("share_links")
}

model ShareLinkRecipient {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shareLinkId    String    @db.Uuid
  shareLink      ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  email          String    @db.VarChar(255)
  token          String    @unique @db.VarChar(255)
  accessCount    Int       @default(0)
  lastAccessedAt DateTime? @db.Timestamptz(6)
  sentAt         DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)

  @@index([shareLinkId])
  @@map("share_link_recipients")
}

// Analytics events hypertable
// Note: create_hypertable is done via raw SQL migration script
model AnalyticsEvent {
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  eventType  String   @db.VarChar(100)
  assetId    String?  @db.Uuid
  asset      Asset?   @relation(fields: [assetId], references: [id])
  properties Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@id([id, createdAt]) // TimescaleDB requires composite primary key on time column
  @@index([orgId, createdAt(sort: Desc)])
  @@map("analytics_events")
}

// Annotation model
model Annotation {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId      String       @db.Uuid
  mediaAsset   Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId       String?      @db.Uuid
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guest details (for unauthenticated external reviewers)
  guestName      String? @db.VarChar(100)
  guestEmail     String? @db.VarChar(255)
  shareLinkToken String? @db.VarChar(255)

  // The type of annotation: e.g., 'comment', 'drawing', 'shape', 'stamp', 'group'
  type String @db.VarChar(50)

  // JSON payload containing tool-specific data (e.g. coordinates, strokes, text, color, replies)
  data Json @default("{}") @db.JsonB

  // Helper columns for fast querying and indexing
  videoTimestamp Decimal? @db.Decimal(10, 3)
  resolved       Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([orgId])
  @@index([assetId])
  @@index([userId])
  @@index([type])
  @@map("annotations")
}

// Represents a custom visibility group for annotations
model AnnotationGroup {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String       @db.Uuid
  workspaceId    String       
  mediaId        String       @db.Uuid
  name           String       @db.VarChar(50) // STRICT 50 character limit on DB level
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaAsset     Asset        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  
  members        AnnotationGroupMember[]

  @@index([orgId])
  @@index([workspaceId])
  @@index([mediaId])
  @@map("annotation_groups")
}

// Join table connecting users to a specific group
model AnnotationGroupMember {
  groupId        String          @db.Uuid
  userId         String          @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  group          AnnotationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("annotation_group_members")
}

model UserGroup {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String       @db.VarChar(100)
  description  String?      @db.VarChar(500)
  createdById  String?      @db.Uuid
  createdBy    User?        @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  members      UserGroupMember[]
  assetGroups  AssetGroup[]
  workspaceGroups WorkspaceGroup[]
  projects     ProjectGroup[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("user_groups")
}

model UserGroupMember {
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  addedAt   DateTime  @default(now()) @db.Timestamptz(6)

  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(255)
  show        Int?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// Note: create_hypertable is done via raw SQL migration script
model AuditLog {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityName String  @db.VarChar(255)
  description  String? @db.Text
  activityType String? @db.VarChar(100)

  actorType String  @default("user") @db.VarChar(20) // 'user' | 'system' | 'cron'
  userName  String? @db.VarChar(255)
  userEmail String? @db.VarChar(255)
  userRole  String? @db.VarChar(50)

  error String? @db.Text

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orgId        String?       @db.Uuid
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([orgId])
  @@index([userId])
  @@index([actorType])
  @@map("audit_logs")
}

model PaymentLog {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String?           @db.Uuid
  organization          Organization?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  userId                String?           @db.Uuid
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  stripeCustomerId      String?           @db.VarChar(255)
  stripeSessionId       String?           @db.VarChar(255)
  stripePaymentIntentId String?           @db.VarChar(255)
  stripeSubscriptionId  String?           @db.VarChar(255)

  status                String            @default("PENDING") @db.VarChar(50)
  amountCents           Int?
  currency              String            @default("usd") @db.VarChar(10)
  planId                String?           @db.VarChar(255)
  planName              String?           @db.VarChar(255)
  invoicePdf            String?           @db.Text
  invoiceUrl            String?           @db.Text
  metadata              Json?             @default("{}") @db.JsonB

