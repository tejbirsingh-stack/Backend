  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  assetId   String?  @db.Uuid
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, assetId])
  @@unique([userId, folderId])
  @@unique([userId, projectId])
  @@index([userId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Platform Admin (NOAH-owned operators — not customer org users)
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @unique @db.VarChar(255)
  name                String?   @db.VarChar(100)
  passwordHash        String    @db.VarChar(255)
  status              String    @default("active") @db.VarChar(50) // active | inactive | suspended
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime? @db.Timestamptz(6)
  lastLoginAt         DateTime? @db.Timestamptz(6)
  lastActiveAt        DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  sessions         PlatformSession[]
  moderationFlags  PlatformModerationFlag[] @relation("FlaggedBy")

  @@map("platform_admins")
}

model PlatformSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId      String    @db.Uuid
  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token        String    @unique @db.Text
  ipAddress    String?   @db.VarChar(50)
  userAgent    String?   @db.Text
  expiresAt    DateTime  @db.Timestamptz(6)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([adminId])
  @@index([token])
  @@map("platform_sessions")
}

/// Sellable plan/package catalog managed by Platform Admins
model Plan {
  id                 String   @id @default(uuid()) @db.VarChar(255)
  name               String   @db.VarChar(100)
  description        String?  @db.Text
  monthlyPriceCents  Int      @default(0)
  yearlyPriceCents   Int      @default(0)
  storageQuotaBytes  BigInt   @default(5368709120) // 5GB
  maxUsers           Int      @default(2)
  maxWorkspaces      Int      @default(1)
  maxProjects        Int      @default(1)
  features           Json     @default("[]") @db.JsonB
  monthlyPriceId     String?  @db.VarChar(255) // Stripe monthly price id
  yearlyPriceId      String?  @db.VarChar(255) // Stripe yearly price id
  isPublic           Boolean  @default(true)
  isFeatured         Boolean  @default(false)
  sortOrder          Int      @default(0)
  ctaLabel           String?  @db.VarChar(100)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organizations Organization[]

  @@index([isPublic, sortOrder])
  @@map("plans")
}

/// Lightweight landing page CMS (existing table: landing_page_content)
model LandingPage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String    @unique @db.VarChar(100) @default("main")
  status        String    @default("draft") @db.VarChar(50) // draft | published
  heroTitle     String?   @db.VarChar(500)
  heroSubtitle  String?   @db.Text
  ctaLabel      String?   @db.VarChar(100)
  ctaHref       String?   @db.VarChar(500)
  sections      Json      @default("[]") @db.JsonB
  publishedAt   DateTime? @db.Timestamptz(6)
  updatedById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("landing_page_content")
}

/// Starter files seeded into new users' default workspaces
model PlatformDefaultContent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String   @db.VarChar(255)
  fileName     String   @db.VarChar(500)
  filePath     String   @db.VarChar(1000) // B2 key for the template file
  mimeType     String   @db.VarChar(100)
  sizeBytes    BigInt
  assetType    String   @db.VarChar(50) // video | audio | image | document
  sortOrder    Int      @default(0)
  isEnabled    Boolean  @default(true)
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([isEnabled, sortOrder])
  @@map("platform_default_content")
}

/// Cross-org content moderation flags
model PlatformModerationFlag {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId         String   @db.Uuid
  orgId           String   @db.Uuid
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reason          String   @db.VarChar(500)
  status          String   @default("open") @db.VarChar(50) // open | quarantined | resolved | dismissed
  notes           String?  @db.Text
  flaggedById     String?  @db.Uuid
  flaggedBy       PlatformAdmin? @relation("FlaggedBy", fields: [flaggedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([orgId])
  @@index([assetId])
  @@map("platform_moderation_flags")
}

enum StorageProvider {
  BACKBLAZE_B2
  AWS_S3
  MINIO
  ON_PREM
}

enum UsageMetric {
  STORAGE_BYTES_DELTA
  BANDWIDTH_BYTES
  CLASS_A
  CLASS_B
  SEAT_CHANGE
}

model StorageSystem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String          @db.Uuid
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider     StorageProvider @default(BACKBLAZE_B2)
  name         String          @db.VarChar(100)
  config       Json            @default("{}") @db.JsonB
  isPrimary    Boolean         @default(true)
  status       String          @default("active") @db.VarChar(50)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  usageEvents       UsageEvent[]
  usageDailyRollups UsageDailyRollup[]

  @@unique([orgId, provider, name])
  @@index([orgId, provider])
  @@map("storage_systems")
}

model UsageEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String         @db.Uuid
  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  storageSystemId String?        @db.Uuid
  storageSystem   StorageSystem? @relation(fields: [storageSystemId], references: [id], onDelete: SetNull)
  userId          String?        @db.Uuid
  assetId         String?        @db.Uuid
  assetFileId     String?        @db.Uuid
  metric          UsageMetric
  delta           BigInt         @default(0)
  metadata        Json           @default("{}") @db.JsonB
  occurredAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@index([orgId, occurredAt])
  @@index([orgId, metric, occurredAt])
  @@index([storageSystemId, occurredAt])
  @@map("usage_events")
}

model UsageDailyRollup {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String         @db.Uuid
  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  storageSystemId String?        @db.Uuid
  storageSystem   StorageSystem? @relation(fields: [storageSystemId], references: [id], onDelete: SetNull)
  date            DateTime       @db.Date
  storageBytesEnd BigInt         @default(0)
  bandwidthBytes  BigInt         @default(0)
  classACount     BigInt         @default(0)
  classBCount     BigInt         @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([orgId, storageSystemId, date])
  @@index([orgId, date])
  @@map("usage_daily_rollups")
}

model AccessLevel {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  title       String?  @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  workspaceUsers  WorkspaceUser[] @relation("WorkspaceUserAccess")
  workspaceGroups WorkspaceGroup[] @relation("WorkspaceGroupAccess")
  projectUsers    ProjectUser[]   @relation("ProjectUserAccess")
  projectGroups   ProjectGroup[]  @relation("ProjectGroupAccess")
  permissions     AccessLevelPermission[]

  @@map("access_levels")
}

model AccessLevelPermission {
  accessLevelId String      @db.Uuid
  permissionId  String      @db.Uuid
  accessLevel   AccessLevel @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)

  @@id([accessLevelId, permissionId])
  @@index([accessLevelId])
  @@index([permissionId])
  @@map("access_level_permissions")
}

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
