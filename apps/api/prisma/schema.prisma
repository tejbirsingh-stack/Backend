model PaymentEventLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentLogId  String?     @db.Uuid
  paymentLog    PaymentLog? @relation(fields: [paymentLogId], references: [id], onDelete: Cascade)

  eventType     String      @db.VarChar(100)
  status        String      @db.VarChar(50)
  failureReason String?     @db.Text
  metadata      Json?       @default("{}") @db.JsonB

  createdAt     DateTime    @default(now()) @db.Timestamptz(6)

  @@index([paymentLogId])
  @@index([eventType])
  @@map("payment_events_log")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique @db.VarChar(255)
  name        String           @db.VarChar(255)
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]
  accessLevels AccessLevelPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}


model AssetFile {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId   String  @db.Uuid
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileClass String  @db.VarChar(50) // 'original', 'proxy', 'thumbnail', 'hls_playlist'
  fileName  String  @db.VarChar(500)
  filePath  String  @db.VarChar(1000) // B2 Key
  sizeBytes BigInt
  mimeType  String  @db.VarChar(100)
  cdnUrl    String? @db.VarChar(500)

  @@index([assetId])
  @@index([fileClass])
  @@map("asset_files")
}

model AssetMetadata {
  assetId          String  @id @db.Uuid
  asset            Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technicalSpecs   Json    @default("{}") @db.JsonB // width, height, fps, bitrate, codec, duration
  customProperties Json    @default("{}") @db.JsonB // user-defined metadata
  checksum         String? @db.VarChar(64)

  @@map("asset_metadata")
}

model TranscodeJob {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId          String  @db.Uuid
  asset            Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider         String  @db.VarChar(50) // 'coconut', 'aws_mediaconvert'
  jobId            String? @unique @db.VarChar(255)
  status           String  @default("queued") @db.VarChar(50) // 'queued', 'processing', 'completed', 'failed'
  providerMetadata Json    @default("{}") @db.JsonB // API responses, errors

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([assetId])
  @@index([status])
  @@map("transcode_jobs")
}

model VideoFrameHash {
