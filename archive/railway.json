{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npx prisma generate --schema=./packages/@noah/db/prisma/schema.prisma"
  },
  "deploy": {
    "startCommand": "node apps/api/src/enhanced-media-server.cjs",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}