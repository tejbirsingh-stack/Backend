# Railway Environment Variables Template
# Copy these to your Railway service variables

# Database (Provided by Railway PostgreSQL)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Application
NODE_ENV=production
PORT=3000
API_URL=https://your-app.railway.app

# JWT Secret (Generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session
SESSION_SECRET=your-session-secret-change-this

# CORS
CORS_ORIGIN=https://your-frontend.railway.app

# Storage (Backblaze B2)
B2_KEY_ID=001cb7600b546c10000000004
B2_APPLICATION_KEY=K001WSskmgndvo+F7wwQemyz2JPxdRI
B2_BUCKET_NAME=NoahDemo
B2_ENDPOINT=https://s3.us-west-001.backblazeb2.com  # Optional, change based on your region
B2_REGION=us-west-001  # Optional, change based on your bucket location

# Redis (if using Railway Redis)
REDIS_URL=${{Redis.REDIS_URL}}

# File Upload
MAX_FILE_SIZE=524288000
ALLOWED_FILE_TYPES=video/mp4,video/webm,video/quicktime,image/jpeg,image/png,image/gif,audio/mpeg,audio/wav

# Organization Defaults
DEFAULT_ORG_STORAGE_LIMIT=107374182400
DEFAULT_USER_STORAGE_LIMIT=10737418240

# Feature Flags
ENABLE_COMPRESSION=false
ENABLE_AI_TAGGING=false
ENABLE_PUBLIC_SHARING=true

# Monitoring (optional)
SENTRY_DSN=
ANALYTICS_ID=