{
  "name": "noah-platform",
  "version": "1.0.0",
  "description": "Noah Media Asset Management Platform - Netflix-scale media platform with neural compression",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/@noah/*"
  ],
  "scripts": {
    "start:production": "cd apps/api && node dist/index.js",
    "dev": "turbo run dev",
    "build": "npm run db:generate && turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "cd packages/@noah/db && npx prisma generate",
    "db:push": "cd packages/@noah/db && npx prisma db push",
    "db:migrate": "cd packages/@noah/db && npx prisma migrate dev",
    "db:studio": "cd packages/@noah/db && npx prisma studio",
    "db:sync": "cp packages/@noah/db/prisma/schema.prisma apps/api/prisma/schema.prisma && npm run db:generate && cd apps/api && npx prisma generate",
    "setup": "npm install && npm run db:generate && npm run build:packages",
    "postinstall": "npm run db:generate",
    "start:api": "cd apps/api && npm run dev",
    "start:web": "cd apps/web && npm run dev",
    "start:compression": "cd apps/compression && cargo run",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:reset": "docker compose -f docker-compose.dev.yml down -v",
    "docker:simple": "docker compose -f docker-compose.simple.yml up -d"
  },
  "devDependencies": {
    "@prisma/client": "^6.15.0",
    "@types/node": "^20.10.0",
    "prisma": "^6.15.0",
    "turbo": "^1.10.16",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^20.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "media",
    "asset",
    "management",
    "video",
    "compression",
    "netflix",
    "platform",
    "typescript",
    "react",
    "fastify"
  ],
  "author": "Noah Platform Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.873.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fastify": "^5.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "stripe": "^22.5.0",
    "uuid": "^11.1.0"
  }
}
