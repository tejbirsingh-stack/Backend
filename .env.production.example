# Noah Platform Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database
POSTGRES_PASSWORD=secure_password_here
REPLICATOR_PASSWORD=secure_password_here

# Redis
REDIS_PASSWORD=secure_password_here

# Authentication
JWT_SECRET=secure_random_string_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
COOKIE_SECRET=secure_random_string_here
MFA_ISSUER=Noah Media Platform

# Frontend
FRONTEND_URL=https://app.example.com

# Storage
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=access_key_here
S3_SECRET_KEY=secret_key_here
S3_BUCKET=noah-assets

# Monitoring
GRAFANA_ADMIN_PASSWORD=secure_password_here

# Elasticsearch
ELASTIC_PASSWORD=secure_password_here

# Other Services
KAFKA_RETENTION_MS=604800000  # 7 days
