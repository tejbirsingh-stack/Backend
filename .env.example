# Noah Media Asset Management Platform - Development Environment
# Copy this file to .env and update values as needed

# Database Configuration
DATABASE_URL="postgresql://noah_user:noah_dev_password@localhost:5432/noah_dev"
POSTGRES_USER=noah_user
POSTGRES_PASSWORD=noah_dev_password
POSTGRES_DB=noah_dev

# Redis Configuration
REDIS_URL="redis://:noah_redis_password@localhost:6379"
REDIS_PASSWORD=noah_redis_password
REDIS_SENTINEL_SERVICE_NAME=noah-master
REDIS_SENTINEL_HOST=localhost
REDIS_SENTINEL_PORT=26379

# JWT & Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-productionn"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key"
REFRESH_TOKEN_EXPIRES_IN=30d

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key-here"
BCRYPT_ROUNDS=12

# Storage Configuration (Development uses Minio)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=noah_minio_user
MINIO_SECRET_KEY=noah_minio_password
MINIO_BUCKET=noah-dev-assets
MINIO_USE_SSL=false

# Production B2 Configuration (commented out for dev)
# B2_APPLICATION_KEY_ID=your_b2_key_id
# B2_APPLICATION_KEY=your_b2_application_key
# B2_BUCKET_NAME=noah-production-assets
# B2_BUCKET_ID=your_b2_bucket_id

# Email Configuration (for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@noah-dev.local
SMTP_FROM_NAME="Noah Platform"

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3001,http://localhost:19006
NODE_ENV=development

# Compression Service
COMPRESSION_SERVICE_URL=http://localhost:8080
COMPRESSION_QUEUE_NAME=compression-jobs
COMPRESSION_WORKER_CONCURRENCY=4

# AI Service Configuration
AI_SERVICE_URL=http://localhost:5000
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token

# ============================================
# AI + AWS Secrets Manager (local placeholders)
# ============================================
AI_ENABLED=false
AI_PLAN_ENTITLEMENT=false
AWS_SECRETS_MANAGER_ENABLED=false
AWS_REGION=us-east-1
AWS_AI_SECRET_ID=noah/dev/ai/credentials

# Local IAM user keys (optional). Not needed on ECS/EKS/EC2 with a role.
# Replace with real keys only if you test Secrets Manager from your laptop.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Used when AWS_SECRETS_MANAGER_ENABLED=false (local fallback)
ASSEMBLY_API_KEY=your-assembly-ai-key
OPENAI_API_KEY=your-openai-api-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=noah-platform
KAFKA_GROUP_ID=noah-platform-group

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_CREDENTIALS=true
HELMET_ENABLED=true

# File Upload Limits
MAX_FILE_SIZE=10737418240
MAX_FILES_PER_UPLOAD=10
ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-msvideo,image/jpeg,image/png,image/webp

# Development Flags
DEBUG=noah:*
LOG_LEVEL=debug
PRISMA_LOG_LEVEL=info

# Health Check
HEALTH_CHECK_TIMEOUT=30000
HEALTH_CHECK_INTERVAL=60000
