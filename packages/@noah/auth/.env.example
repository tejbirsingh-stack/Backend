# Authentication Environment Variables
# Make a copy of this file named .env and fill in the values

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=replace_with_random_secure_string_for_access_tokens
REFRESH_TOKEN_SECRET=replace_with_different_random_secure_string_for_refresh_tokens

# Token expiry settings
ACCESS_TOKEN_EXPIRY=15m  # 15 minutes
REFRESH_TOKEN_EXPIRY=7d  # 7 days

# MFA settings
MFA_ISSUER=Noah Media Platform

# Rate limiting
AUTH_RATE_LIMIT_POINTS=5  # Number of login attempts before rate limiting
AUTH_RATE_LIMIT_DURATION=900  # Duration in seconds (15 minutes)

# Database connection
# These should typically be set at the application level, not here
# DATABASE_URL=postgresql://username:password@hostname:port/database

# Logging
LOG_LEVEL=info  # Possible values: error, warn, info, debug
